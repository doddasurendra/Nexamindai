# NexaMind AI environment variables

Copy this file to `.env` (backend directory) and fill in real values. Never commit `.env`.

# Application
APP_NAME=NexaMind AI
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite works out of the box; PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/nexamind.db
AUTO_CREATE_TABLES=true

# OpenRouter (required for chat, agents, RAG answers, evaluation)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=NexaMind AI
OPENROUTER_APP_URL=http://localhost:5173
DEFAULT_MODEL=openai/gpt-4o-mini
FALLBACK_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
MAX_CONTEXT_TOKENS=12000

# Web search / Deep Research
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-...
SEARCH_MAX_RESULTS=6

# Hugging Face
HF_TOKEN=hf_...
HF_BASE_URL=https://router.huggingface.co/v1
HF_INFERENCE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Media generation
IMAGE_GENERATION_MODEL=google/gemini-2.5-flash-image
VIDEO_GENERATION_PROVIDER=replicate
REPLICATE_API_TOKEN=r8_...
VIDEO_MODEL=minimax/video-01

# Google Sign-In (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Firebase (optional; when configured, use Firestore as primary database)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_PATH=/path/to/service-account.json
FIREBASE_BUCKET=your-project-id.firebasestorage.app

# Storage
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_TYPES=pdf,docx,txt,csv,xlsx,png,jpg,jpeg,webp,gif,mp4,webm

# Security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
ALLOW_PRIVATE_URLS=false
MAX_URL_BYTES=2000000
URL_FETCH_TIMEOUT_SECONDS=15

# Embeddings: local (offline, deterministic) or openrouter
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
